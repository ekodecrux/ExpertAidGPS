# Global binary file handling
*.png binary diff=exif
*.jpg binary diff=exif
*.jpeg binary diff=exif
*.gif binary diff=exif
*.jar binary
*.zip binary
*.apk binary

# Disable CRLF conversion for all files
* text=auto

# Explicitly set line endings for text files
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
